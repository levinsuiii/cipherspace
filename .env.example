# Local API process
DATABASE_URL=postgres://cipherspace:cipherspace_dev@localhost:5432/cipherspace
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
NODE_ENV=development
# Development only. Generate a random value before starting; production rejects this marker.
SESSION_SECRET=dev-only-change-me-before-running-32-bytes-minimum
SESSION_TTL_HOURS=168
REQUEST_BODY_LIMIT_BYTES=1500000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Exact comma-separated browser origins. Use an empty value when all browser traffic is same-origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Docker Compose PostgreSQL service
POSTGRES_DB=cipherspace
POSTGRES_USER=cipherspace
POSTGRES_PASSWORD=cipherspace_dev
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
API_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

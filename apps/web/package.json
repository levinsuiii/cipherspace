{
  "name": "@cipherspace/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "check:pwa": "node scripts/check-pwa.mjs",
    "dev": "vite",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "prebuild": "npm run build --workspace @cipherspace/crypto",
    "pretest": "npm run build --workspace @cipherspace/crypto",
    "pretypecheck": "npm run build --workspace @cipherspace/crypto",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@cipherspace/crypto": "0.1.0",
    "@tanstack/react-query": "^5.85.5",
    "dexie": "^4.4.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
